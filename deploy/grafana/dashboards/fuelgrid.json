{
  "uid": "fuelgrid-ops",
  "title": "FuelGrid - Operations & Intelligence",
  "tags": ["fuelgrid"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Service level", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_service_level", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.9 }, { "color": "green", "value": 0.98 }] } } } },
    { "id": 2, "type": "stat", "title": "Critical / warning alerts", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_open_alerts{severity=\"CRITICAL\"}", "legendFormat": "critical", "refId": "A" }, { "expr": "fg_open_alerts{severity=\"WARNING\"}", "legendFormat": "warning", "refId": "B" }] },
    { "id": 3, "type": "stat", "title": "Simulator link", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "1 - fg_sim_breaker_open", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "BREAKER OPEN", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } } }] } } },
    { "id": 4, "type": "stat", "title": "Degraded mode", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_degraded", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "LIVE", "color": "green" }, "1": { "text": "DEGRADED", "color": "orange" } } }] } } },
    { "id": 5, "type": "stat", "title": "Forecast error (MAPE)", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_forecast_mape", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.15 }, { "color": "red", "value": 0.25 }] } } } },
    { "id": 6, "type": "stat", "title": "Database", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_db_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN (buffering)", "color": "orange" }, "1": { "text": "UP", "color": "green" } } }] } } },

    { "id": 10, "type": "timeseries", "title": "API request rate", "gridPos": { "x": 0, "y": 4, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total[30s])) by (status)", "legendFormat": "{{status}}", "refId": "A" }] },
    { "id": 11, "type": "timeseries", "title": "API latency p50 / p95 / p99", "gridPos": { "x": 8, "y": 4, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99", "refId": "C" }] },
    { "id": 12, "type": "timeseries", "title": "Simulator calls by outcome", "gridPos": { "x": 16, "y": 4, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(fg_sim_requests_total[30s])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A" }] },

    { "id": 20, "type": "timeseries", "title": "Decision cycle latency p95", "gridPos": { "x": 0, "y": 11, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(fg_decision_cycle_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "A" }] },
    { "id": 21, "type": "timeseries", "title": "Fallback activations", "gridPos": { "x": 8, "y": 11, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(fg_fallback_total[1m])) by (component, reason)", "legendFormat": "{{component}} / {{reason}}", "refId": "A" }] },
    { "id": 22, "type": "timeseries", "title": "Forecast confidence and error", "gridPos": { "x": 16, "y": 11, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "fg_forecast_confidence", "legendFormat": "confidence", "refId": "A" }, { "expr": "fg_forecast_mape", "legendFormat": "MAPE", "refId": "B" }] },

    { "id": 30, "type": "timeseries", "title": "Open shortage alerts by severity", "gridPos": { "x": 0, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "fg_open_alerts", "legendFormat": "{{severity}}", "refId": "A" }] },
    { "id": 31, "type": "timeseries", "title": "Recommendations and allocations", "gridPos": { "x": 8, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(fg_recommendations_total[1m]))", "legendFormat": "recommended", "refId": "A" }, { "expr": "sum(increase(fg_allocations_total[1m])) by (result)", "legendFormat": "allocation {{result}}", "refId": "B" }] },
    { "id": 32, "type": "timeseries", "title": "Service level over time", "gridPos": { "x": 16, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "fg_service_level", "legendFormat": "service level", "refId": "A" }] }
  ]
}
