# Copy to .env (never commit .env). All values are for the simulator environment only.

# Organizer simulator
SIM_BASE_URL=http://127.0.0.1:8000

# PostgreSQL with the pgvector extension. `docker compose up -d db` starts a local one that matches this default.
# Leave empty to run memory-only. A hosted Postgres (Supabase, Neon, RDS...) also works: paste its connection string.
DATABASE_URL=postgresql://fuelgrid:fuelgrid@127.0.0.1:5432/fuelgrid
POSTGRES_PASSWORD=fuelgrid

# Data source at start-up: simulator | feed (switchable at runtime from the console)
DATA_SOURCE=simulator
# Live feed: a feed silent longer than this is reported stale; optional webhook receives every approved order
# FEED_STALE_AFTER_S=120
# FEED_WEBHOOK_URL=

# Browser origins allowed to call the API when the console is hosted elsewhere (e.g. https://fuelgrid.vercel.app); comma separated
# CORS_ORIGINS=

# Behaviour
AUTO_EXECUTE=false        # keep false: a person approves shipments
ACTIVE_POLICY=optimizer   # optimizer | rules
# API_KEY=                # optional: require X-API-Key for write endpoints

# Optional AI wording for the Ops assistant (free tiers). Gemini first (models discovered and rotated automatically), Groq as backup.
# Without keys the assistant still works: answers are built directly from live data.
GEMINI_API_KEY=
GROQ_API_KEY=

# Grafana admin password for the monitoring profile (defaults to admin for local demos)
GRAFANA_ADMIN_PASSWORD=

# ---- Tuning (defaults were chosen by measurement, see docs/TUNING.md; change only with a reason) ----
# DECISION_EVERY_TICKS=2        plan every N ticks
# POLL_INTERVAL_S=2             how often the source is read
# STALE_AFTER_S=15              data older than this suspends automatic dispatch
# MAX_AUTO_LITERS=20000         per-cycle cap for automatic dispatch
# AUTO_MAX_SINGLE_L=9000        a single shipment above this always needs a person
# AUTO_MIN_SEVERITY=OK          OK | WATCH | WARNING | CRITICAL
# MIN_CONFIDENCE=0.35           below this a person must review
# FORECASTER=learned            learned | seasonal | seasonal_v1 | moving_avg
# AUTO_RETRAIN=true             retrain a challenger on collected history and promote it only if it beats the champion
# RETRAIN_EVERY_TICKS=480
# ONLINE_ADAPTATION=true        per-series correction that follows level shifts within a few ticks
# TARGET_COVER_TICKS=32         stock target in ticks (8 h at 15-minute ticks)
# SAFETY_Z=2.0                  safety buffer in standard deviations of forecast error
# OPTIMIZER_TIMEOUT_S=2.0
# SIM_TIMEOUT_S=4  SIM_RETRIES=3  SIM_MAX_CONCURRENCY=4  BREAKER_FAILURES=5  BREAKER_RESET_S=3
# ASSISTANT_PER_MINUTE=30
# LOG_LEVEL=INFO
